# Copy thành .env cho local: cp .env.example .env
# Vercel: khai báo VITE_API_BASE_URL trong Project Settings → Environment Variables

# Local (khuyến nghị): relative /api → Vite proxy tới http://localhost:8080
VITE_API_BASE_URL=/api

# Local gọi thẳng BE (bỏ comment dòng trên, dùng dòng này — BẮT BUỘC có http://):
# VITE_API_BASE_URL=http://localhost:8080/api

# Production (Vercel):
# VITE_API_BASE_URL=https://YOUR-BACKEND-DOMAIN/api
